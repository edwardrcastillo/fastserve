def generate_qr_matrix(data_str):
    lines = [
        " ┌────────────────────────────────────────┐ ",
        f" │  🔗 ESCANEA O ABRE EN TU NAVEGADOR     │ ",
        f" │  👉 {data_str:<34} │ ",
        " └────────────────────────────────────────┘ "
    ]
    return "\n".join(lines)

def get_lan_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"

def format_size(size_bytes):
    if size_bytes is None:
        return "--"
    for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
        if size_bytes < 1024.0 or unit == 'TB':
            return f"{size_bytes:.1f} {unit}" if unit != 'B' else f"{int(size_bytes)} B"
        size_bytes /= 1024.0
    return f"{size_bytes:.1f} TB"

def get_file_icon(ext, is_dir=False):
    if is_dir:
        return "📁"
    ext = ext.lower()
    if ext in ['.iso', '.img', '.dmg', '.vmdk', '.qcow2']:
        return "💿"
    elif ext in ['.zip', '.tar', '.gz', '.bz2', '.xz', '.7z', '.rar', '.zst']:
        return "📦"
    elif ext in ['.mp4', '.mkv', '.avi', '.mov', '.webm', '.ts', '.m4v']:
        return "🎬"
    elif ext in ['.mp3', '.flac', '.wav', '.m4a', '.aac', '.ogg']:
        return "🎵"
    elif ext in ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.svg', '.bmp']:
        return "🖼️"
    elif ext in ['.pdf', '.doc', '.docx', '.txt', '.md', '.rtf']:
        return "📄"
    elif ext in ['.py', '.sh', '.js', '.ts', '.html', '.css', '.json', '.c', '.cpp', '.rs', '.go']:
        return "💻"
    elif ext in ['.exe', '.bin', '.app', '.deb', '.rpm', '.apk', '.msi']:
        return "⚙️"
    return "📎"

