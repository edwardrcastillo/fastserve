    <script>
        const CURRENT_DIR_REL = "{{CURRENT_REL_DIR}}";

        function filterFiles() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const items = document.querySelectorAll('.file-item');
            items.forEach(item => {
                const name = item.getAttribute('data-name');
                if (name && name.toLowerCase().includes(query)) {
                    item.style.display = 'grid';
                } else if (name) {
                    item.style.display = 'none';
                }
            });
        }

        function copyCmd(text, msg) {
            navigator.clipboard.writeText(text).then(() => {
                showToast(msg || 'Comando copiado al portapapeles');
            });
        }

        function showToast(msg, icon) {
            const t = document.getElementById('toast');
            document.getElementById('toastMsg').innerText = msg;
            document.getElementById('toastIcon').innerText = icon || '📋';
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 3000);
        }

        // -------------------------------------------------------------
        // 📤 High-Speed Chunked Upload Client Logic
        // -------------------------------------------------------------
        let uploadQueue = [];
        let isUploading = false;

        function triggerFilePicker() {
            document.getElementById('fileUploadInput').click();
        }

        function handleFileSelect(e) {
            const files = Array.from(e.target.files);
            if (files.length > 0) {
                enqueueFiles(files);
            }
            e.target.value = '';
        }

        // Drag and Drop Events
        window.addEventListener('dragenter', (e) => {
            e.preventDefault();
            document.getElementById('dropOverlay').classList.add('active');
        });

        window.addEventListener('dragover', (e) => {
            e.preventDefault();
        });

        document.getElementById('dropOverlay').addEventListener('dragleave', (e) => {
            e.preventDefault();
            document.getElementById('dropOverlay').classList.remove('active');
        });

        document.getElementById('dropOverlay').addEventListener('drop', (e) => {
            e.preventDefault();
            document.getElementById('dropOverlay').classList.remove('active');
            if (e.dataTransfer && e.dataTransfer.files.length > 0) {
                enqueueFiles(Array.from(e.dataTransfer.files));
            }
        });

        function enqueueFiles(files) {
            uploadQueue.push(...files);
            if (!isUploading) {
                processNextUpload();
            }
        }

        function formatBytes(bytes) {
            if (bytes === 0) return '0 B';
            const k = 1024;
            const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
        }

        function processNextUpload() {
            if (uploadQueue.length === 0) {
                isUploading = false;
                const card = document.getElementById('uploadProgressCard');
                setTimeout(() => card.classList.remove('show'), 1500);
                return;
            }

            isUploading = true;
            const file = uploadQueue.shift();
            const card = document.getElementById('uploadProgressCard');
            card.classList.add('show');

            document.getElementById('uploadFileName').innerText = `📤 ${file.name} (${uploadQueue.length > 0 ? '+' + uploadQueue.length + ' en cola' : ''})`;
            document.getElementById('progressBarFill').style.width = '0%';
            document.getElementById('uploadPercentage').innerText = '0%';
            document.getElementById('uploadSpeed').innerText = '⚡ Calculando...';

            const url = `/api/upload?dir=${encodeURIComponent(CURRENT_DIR_REL)}&filename=${encodeURIComponent(file.name)}`;
            const xhr = new XMLHttpRequest();
            xhr.open('POST', url, true);

            let startTime = Date.now();
            let lastLoaded = 0;
            let lastTime = startTime;

            xhr.upload.onprogress = (e) => {
                if (e.lengthComputable) {
                    const percent = Math.round((e.loaded / e.total) * 100);
                    document.getElementById('progressBarFill').style.width = percent + '%';
                    document.getElementById('uploadPercentage').innerText = percent + '%';
                    document.getElementById('uploadProgressBytes').innerText = `${formatBytes(e.loaded)} / ${formatBytes(e.total)}`;

                    const now = Date.now();
                    const timeDiff = (now - lastTime) / 1000;
                    if (timeDiff >= 0.5) {
                        const bytesDiff = e.loaded - lastLoaded;
                        const speedBps = bytesDiff / timeDiff;
                        document.getElementById('uploadSpeed').innerText = `⚡ ${formatBytes(speedBps)}/s`;
                        lastLoaded = e.loaded;
                        lastTime = now;
                    }
                }
            };

            xhr.onload = () => {
                if (xhr.status === 200) {
                    showToast(`Subido con éxito: ${file.name}`, '✅');
                    setTimeout(() => {
                        processNextUpload();
                    }, 400);
                } else {
                    showToast(`Error al subir ${file.name}: ${xhr.statusText}`, '❌');
                    processNextUpload();
                }
            };

            xhr.onerror = () => {
                showToast(`Fallo de conexión al subir ${file.name}`, '❌');
                processNextUpload();
            };

            xhr.send(file);
        }
    </script>
</body>
</html>
"""

# -----------------------------------------------------------------------------
# 🚀 FastServe HTTP Request Handler (Byte-Range + Streaming Uploads)
# -----------------------------------------------------------------------------
class FastServeHandler(BaseHTTPRequestHandler):
    root_path = os.getcwd()
    is_single_file = False
    single_file_path = None
    allow_upload = True

    def send_safe_header(self, keyword, value):
        try:
            self.send_header(keyword, value)
        except Exception:
            pass

    def log_message(self, format, *args):
        pass # Silent logging for maximum transfer throughput

    def get_real_path(self, url_path):
        parsed = urllib.parse.unquote(url_path).lstrip('/')
        target = os.path.abspath(os.path.join(self.root_path, parsed))
        if not target.startswith(self.root_path):
            return None
        return target

    def do_POST(self):
        parsed_url = urllib.parse.urlparse(self.path)
        
        # 📤 API de Subida Directa de Archivos en Streaming (0 RAM overhead)
        if parsed_url.path == "/api/upload":
            if not self.allow_upload or self.is_single_file:
                self.send_error(403, "Subidas no permitidas en este modo")
                return

            query = urllib.parse.parse_qs(parsed_url.query)
            rel_dir = query.get("dir", ["."])[0]
            raw_filename = query.get("filename", [None])[0]

            if not raw_filename:
                self.send_error(400, "Parámetro filename requerido")
                return

            safe_filename = os.path.basename(urllib.parse.unquote(raw_filename))
            target_dir = self.get_real_path(rel_dir)
            if not target_dir or not os.path.isdir(target_dir):
                self.send_error(400, "Directorio destino inválido")
                return

            final_dest = os.path.join(target_dir, safe_filename)
            tmp_dest = final_dest + f".fastserve_{int(time.time())}.tmp"

            try:
                content_length = int(self.headers.get("Content-Length", 0))
                remaining = content_length
                
                with open(tmp_dest, "wb") as f:
                    while remaining > 0:
                        chunk_size = min(remaining, 128 * 1024)
                        data = self.rfile.read(chunk_size)
                        if not data:
                            break
                        f.write(data)
                        remaining -= len(data)

                if os.path.exists(tmp_dest):
                    os.replace(tmp_dest, final_dest)

                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                resp = json.dumps({"success": True, "filename": safe_filename, "size": os.path.getsize(final_dest)})
                self.wfile.write(resp.encode("utf-8"))
            except Exception as e:
                if os.path.exists(tmp_dest):
                    try:
                        os.remove(tmp_dest)
                    except Exception:
                        pass
                self.send_error(500, f"Error durante la subida: {e}")
            return

        self.send_error(404)

    def do_GET(self):
        parsed_url = urllib.parse.urlparse(self.path)
        path = parsed_url.path
        query = urllib.parse.parse_qs(parsed_url.query)

        # 1. Modo Archivo Único
        if self.is_single_file:
            if query.get("download", ["0"])[0] == "1":
                self.serve_file_stream(self.single_file_path, as_attachment=True)
                return
            else:
                self.serve_single_file_page(self.single_file_path)
                return

        # 2. Modo Directorio
        real_path = self.get_real_path(path)
        if not real_path or not os.path.exists(real_path):
            self.send_error(404, "Elemento no encontrado")
            return

        if os.path.isdir(real_path):
            self.serve_directory_page(real_path, path)
        else:
            as_attach = query.get("download", ["1"])[0] == "1"
            self.serve_file_stream(real_path, as_attachment=as_attach)

