# -----------------------------------------------------------------------------
# 🚀 FastServe HTTP Request Handler with Full Byte-Range Support
# -----------------------------------------------------------------------------
class FastServeHandler(BaseHTTPRequestHandler):
    root_path = os.getcwd()
    is_single_file = False
    single_file_path = None

    def send_safe_header(self, keyword, value):
        try:
            self.send_header(keyword, value)
        except Exception:
            pass

    def log_message(self, format, *args):
        pass # Silent logging for maximum I/O performance

    def get_real_path(self, url_path):
        parsed = urllib.parse.unquote(url_path).lstrip('/')
        target = os.path.abspath(os.path.join(self.root_path, parsed))
        # Jail security check
        if not target.startswith(self.root_path):
            return None
        return target

    def do_GET(self):
        parsed_url = urllib.parse.urlparse(self.path)
        path = parsed_url.path
        query = urllib.parse.parse_qs(parsed_url.query)

        # 1. Modo Archivo Único
        if self.is_single_file:
            if query.get("download", ["0"])[0] == "1":
                self.serve_file_stream(self.single_file_path, as_attachment=True)
                return
            else:
                self.serve_single_file_page(self.single_file_path)
                return

        # 2. Modo Directorio
        real_path = self.get_real_path(path)
        if not real_path or not os.path.exists(real_path):
            self.send_error(404, "Elemento no encontrado")
            return

        if os.path.isdir(real_path):
            self.serve_directory_page(real_path, path)
        else:
            as_attach = query.get("download", ["1"])[0] == "1"
            self.serve_file_stream(real_path, as_attachment=as_attach)

    def serve_single_file_page(self, file_path):
        fname = os.path.basename(file_path)
        ext = os.path.splitext(fname)[1]
        sz = os.path.getsize(file_path)
        sz_str = format_size(sz)
        icon = get_file_icon(ext)
        host = self.headers.get('Host', f"localhost:{self.server.server_port}")
        dl_url = f"http://{host}/?download=1"
        
        curl_cmd = f"curl -C - -O '{dl_url}'"
        aria_cmd = f"aria2c -x 16 -s 16 '{dl_url}' -o '{fname}'"

        content = f"""
        <div class="card-container">
            <div class="single-file-hero">
                <div class="hero-icon">{icon}</div>
                <h1 class="hero-title">{fname}</h1>
                <div class="hero-badge">{sz_str} • {ext.upper().replace('.', '') or 'BINARIO'}</div>
                
                <div class="hero-actions">
                    <a href="/?download=1" class="btn btn-primary" style="font-size: 16px; padding: 12px 28px;">
                        ⬇️ Descargar Archivo ({sz_str})
                    </a>
                    <button class="btn btn-secondary" onclick="copyCmd('{dl_url}', 'Enlace directo copiado')">
                        🔗 Copiar Enlace Directo
                    </button>
                </div>

                <div class="cmd-snippet">
                    <code>{curl_cmd}</code>
                    <button class="btn btn-secondary" style="padding: 4px 10px; font-size: 12px;" onclick="copyCmd('{curl_cmd}', 'Comando cURL copiado')">Copiar curl</button>
                </div>

                <div class="cmd-snippet">
                    <code>{aria_cmd}</code>
                    <button class="btn btn-secondary" style="padding: 4px 10px; font-size: 12px;" onclick="copyCmd('{aria_cmd}', 'Comando aria2c copiado')">Copiar aria2c</button>
                </div>
            </div>
        </div>
        """
        html = HTML_TEMPLATE.replace("{{TITLE}}", fname).replace("{{CONTENT}}", content).replace("{{VERSION}}", VERSION)
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(html.encode('utf-8'))))
        self.end_headers()
        self.wfile.write(html.encode('utf-8'))

    def serve_directory_page(self, dir_path, url_path):
        rel_path = os.path.relpath(dir_path, self.root_path)
        parts = [] if rel_path == "." else rel_path.split(os.sep)

        # Breadcrumbs
        bc_html = ['<a href="/">Raíz</a>']
        accum = ""
        for p in parts:
            accum += "/" + p
            bc_html.append(f'<span class="sep">/</span><a href="{accum}">{p}</a>')
        breadcrumbs = '<div class="breadcrumbs">' + "".join(bc_html) + '</div>'

        # Directory listing
        try:
            entries = sorted(os.listdir(dir_path))
        except Exception:
            entries = []

        dirs_list = []
        files_list = []

        for e in entries:
            if e.startswith('.'):
                continue
            full_p = os.path.join(dir_path, e)
            is_d = os.path.isdir(full_p)
            try:
                st = os.stat(full_p)
                mtime = time.strftime('%Y-%m-%d %H:%M', time.localtime(st.st_mtime))
                sz = st.st_size if not is_d else None
            except Exception:
                mtime = "--"
                sz = None

            item_data = {
                "name": e,
                "is_dir": is_d,
                "size": sz,
                "size_str": format_size(sz) if not is_d else "--",
                "mtime": mtime,
                "ext": os.path.splitext(e)[1],
                "url": (url_path.rstrip('/') + '/' + urllib.parse.quote(e))
            }
            if is_d:
                dirs_list.append(item_data)
            else:
                files_list.append(item_data)

        # Sort: Directories first, then files
        all_items = dirs_list + files_list
        items_html = []

        # Parent directory item
        if rel_path != ".":
            parent_url = "/" + "/".join(parts[:-1]) if len(parts) > 1 else "/"
            items_html.append(f"""
            <a href="{parent_url}" class="file-item">
                <span class="file-icon">📁</span>
                <div class="file-info">
                    <span class="file-name">.. (Carpeta anterior)</span>
                </div>
                <span></span>
                <span></span>
                <span></span>
            </a>
            """)

        host = self.headers.get('Host', f"localhost:{self.server.server_port}")

        for it in all_items:
            icon = get_file_icon(it['ext'], it['is_dir'])
            if it['is_dir']:
                items_html.append(f"""
                <a href="{it['url']}" class="file-item" data-name="{it['name']}">
                    <span class="file-icon">{icon}</span>
                    <div class="file-info">
                        <span class="file-name">{it['name']}</span>
                        <span class="file-date">{it['mtime']}</span>
                    </div>
                    <span class="file-size">--</span>
                    <div class="btn-group">
                        <span class="btn btn-secondary" style="pointer-events: none;">Abrir 📂</span>
                    </div>
                    <span></span>
                </a>
                """)
            else:
                dl_link = f"http://{host}{it['url']}?download=1"
                curl_cmd = f"curl -C - -O '{dl_link}'"
                items_html.append(f"""
                <div class="file-item" data-name="{it['name']}">
                    <span class="file-icon">{icon}</span>
                    <div class="file-info">
                        <span class="file-name">{it['name']}</span>
                        <span class="file-date">{it['mtime']}</span>
                    </div>
                    <span class="file-size">{it['size_str']}</span>
                    <div class="btn-group">
                        <a href="{it['url']}?download=1" class="btn btn-primary">⬇️ Descargar</a>
                        <button class="btn btn-secondary" onclick="copyCmd('{dl_link}', 'Enlace copiado')">🔗 Link</button>
                        <button class="btn btn-secondary" onclick="copyCmd('{curl_cmd}', 'Comando cURL copiado')">cURL</button>
                    </div>
                    <span></span>
                </div>
                """)

        if not all_items and rel_path == ".":
            items_html.append('<div style="padding: 40px; text-align: center; color: var(--text-muted);">Esta carpeta está vacía.</div>')

        content = f"""
        {breadcrumbs}
        <div class="card-container">
            <div class="toolbar">
                <span>NOMBRE DEL ARCHIVO</span>
                <span>TAMAÑO</span>
                <span>ACCIONES DE DESCARGA</span>
            </div>
            <div class="file-list">
                {"".join(items_html)}
            </div>
        </div>
        """
        title = os.path.basename(dir_path) if rel_path != "." else "Directorio Compartido"
        html = HTML_TEMPLATE.replace("{{TITLE}}", title).replace("{{CONTENT}}", content).replace("{{VERSION}}", VERSION)
        
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(html.encode('utf-8'))))
        self.end_headers()
        self.wfile.write(html.encode('utf-8'))

    def serve_file_stream(self, file_path, as_attachment=True):
        fname = os.path.basename(file_path)
        try:
            file_size = os.path.getsize(file_path)
        except Exception:
            self.send_error(404, "Archivo no encontrado")
            return

        mime_type, _ = mimetypes.guess_type(file_path)
        if not mime_type:
            mime_type = "application/octet-stream"

        range_header = self.headers.get("Range")
        if range_header:
            match = re.match(r"bytes=(\d+)-(\d*)", range_header)
            if match:
                start = int(match.group(1))
                end = int(match.group(2)) if match.group(2) else file_size - 1
                if start >= file_size:
                    self.send_error(416, "Requested Range Not Satisfiable")
                    return
                end = min(end, file_size - 1)
                content_length = end - start + 1

                self.send_response(206)
                self.send_header("Content-Type", mime_type)
                self.send_header("Content-Range", f"bytes {start}-{end}/{file_size}")
                self.send_header("Content-Length", str(content_length))
                self.send_header("Accept-Ranges", "bytes")
                if as_attachment:
                    self.send_header("Content-Disposition", f'attachment; filename="{urllib.parse.quote(fname)}"')
                self.end_headers()

                try:
                    with open(file_path, "rb") as f:
                        f.seek(start)
                        remaining = content_length
                        while remaining > 0:
                            chunk_size = min(remaining, 128 * 1024)
                            data = f.read(chunk_size)
                            if not data: break
                            self.wfile.write(data)
                            remaining -= len(data)
                except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
                    pass
                return

        # Descarga completa directa
        self.send_response(200)
        self.send_header("Content-Type", mime_type)
        self.send_header("Content-Length", str(file_size))
        self.send_header("Accept-Ranges", "bytes")
        if as_attachment:
            self.send_header("Content-Disposition", f'attachment; filename="{urllib.parse.quote(fname)}"')
        self.end_headers()

        try:
            with open(file_path, "rb") as f:
                while True:
                    data = f.read(128 * 1024)
                    if not data: break
                    self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError, ConnectionAbortedError):
            pass

class ThreadedHTTPServer(ThreadingMixIn, HTTPServer):
    daemon_threads = True
    allow_reuse_address = True

# -----------------------------------------------------------------------------
# 🏁 CLI Entrypoint
# -----------------------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(
        description="⚡ FastServe - Servidor HTTP ultra-rápido de distribución de archivos para red local.",
        formatter_class=argparse.RawTextHelpFormatter
    )
    parser.add_argument("target", nargs="?", default=".", help="Ruta al archivo o carpeta a servir (por defecto: carpeta actual).")
    parser.add_argument("-p", "--port", type=int, default=8080, help="Puerto HTTP específico (por defecto: 8080).")
    parser.add_argument("--bind", default="0.0.0.0", help="Dirección IP de escucha (por defecto: 0.0.0.0).")
    
    args = parser.parse_args()

    target_path = os.path.abspath(args.target)
    if not os.path.exists(target_path):
        print(f"❌ Error: La ruta '{args.target}' no existe.")
        sys.exit(1)

    is_dir = os.path.isdir(target_path)
    FastServeHandler.root_path = target_path if is_dir else os.path.dirname(target_path)
    FastServeHandler.is_single_file = not is_dir
    FastServeHandler.single_file_path = target_path if not is_dir else None

    # Encontrar puerto libre
    port = args.port
    server = None
    for attempt_port in range(port, port + 50):
        try:
            server = ThreadedHTTPServer((args.bind, attempt_port), FastServeHandler)
            port = attempt_port
            break
        except OSError:
            continue

    if not server:
        print(f"❌ Error: No se pudo abrir ningún puerto entre {args.port} y {args.port + 50}.")
        sys.exit(1)

    lan_ip = get_lan_ip()
    local_url = f"http://localhost:{port}"
    lan_url = f"http://{lan_ip}:{port}"

    print("\n" + "=" * 64)
    print("⚡ FastServe - Servidor de Transferencia Directa LAN")
    print("=" * 64)
    if is_dir:
        print(f"📁 Carpeta Compartida : {target_path}")
    else:
        sz_str = format_size(os.path.getsize(target_path))
        print(f"💿 Archivo Individual : {os.path.basename(target_path)} ({sz_str})")

    print(f"🏠 Acceso Local       : {local_url}")
    print(f"🌐 Acceso Red (LAN)   : {lan_url}")
    print("=" * 64)
    print(generate_qr_matrix(lan_url))
    print("=" * 64)
    print("🚀 Servidor listo. Presiona Ctrl+C para detener.\n")

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n🛑 FastServe detenido con éxito.")
        server.server_close()

if __name__ == "__main__":
    main()
